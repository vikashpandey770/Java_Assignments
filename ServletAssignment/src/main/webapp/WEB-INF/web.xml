<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
    https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0">

    <!-- Application level parameter -->
    <context-param>
        <param-name>appTheme</param-name>
        <param-value>dark</param-value>
    </context-param>
    
    <context-param> 
    <param-name>appTheme</param-name> 
    <param-value>dark</param-value> 
    </context-param>

    <!-- PlaylistServlet -->
    <servlet>
        <servlet-name>PlaylistServlet</servlet-name>
        <servlet-class>javaServlet.PlaylistServlet</servlet-class>

        <init-param>
            <param-name>defaultGenre</param-name>
            <param-value>Bollywood</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>PlaylistServlet</servlet-name>
        <url-pattern>/playlist</url-pattern>
    </servlet-mapping>
 <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>


</web-app>

