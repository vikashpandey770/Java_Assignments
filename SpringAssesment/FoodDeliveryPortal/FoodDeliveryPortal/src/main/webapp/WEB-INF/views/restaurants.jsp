<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><body><h2>Restaurants & Menu</h2><a href="dashboard">Dashboard</a><table border="1" cellpadding="8"><tr><th>Restaurant</th><th>City</th><th>Rating</th><th>Menu Item</th><th>Price</th><th>Available</th><th>Order</th></tr><c:forEach var="r" items="${restaurants}"><c:forEach var="m" items="${r.menuItems}"><tr><td>${r.name}</td><td>${r.city}</td><td>${r.rating}</td><td>${m.itemName}</td><td>${m.price}</td><td>${m.available}</td><td><form method="post" action="orders/place"><input type="hidden" name="restaurantId" value="${r.id}"><input type="hidden" name="itemName" value="${m.itemName}"><input name="quantity" type="number" min="1" value="1" required><input name="customerName" placeholder="Customer name" required><button>Place Order</button></form></td></tr></c:forEach></c:forEach></table></body></html>
